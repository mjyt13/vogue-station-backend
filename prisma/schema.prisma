generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum GarmentKind {
  TSHIRT
  SHIRT
  SKIRT
  PANTS
}

// Shared by every moderated asset type (garment models now, patterns later).
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(USER)
  bio           String?
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  garmentModels GarmentModel[]
  colors        Color[]
  patterns      Pattern[]
  looks         Look[]

  @@map("users")
}

model Color {
  id        String   @id @default(uuid())
  name      String
  hex       String
  // null owner = global preset visible to everyone
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String?  @map("owner_id")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  looks     Look[]

  @@index([ownerId])
  @@index([isPublic])
  @@map("colors")
}

model Pattern {
  id           String           @id @default(uuid())
  name         String
  objectKey    String           @map("object_key")
  thumbnailKey String?          @map("thumbnail_key")
  mime         String
  width        Int?
  height       Int?
  // false until the client confirms the upload and the bytes are validated
  confirmed    Boolean          @default(false)
  owner        User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String?          @map("owner_id")
  isPublic     Boolean          @default(false) @map("is_public")
  status       ModerationStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  looks        Look[]

  @@index([ownerId])
  @@index([isPublic, status])
  @@index([status])
  @@map("patterns")
}

model GarmentModel {
  id        String           @id @default(uuid())
  name      String
  kind      GarmentKind
  objectKey String           @map("object_key")
  // null owner = official catalog item
  owner     User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String?          @map("owner_id")
  isPublic  Boolean          @default(false) @map("is_public")
  status    ModerationStatus @default(PENDING)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at")
  looks     Look[]

  @@index([ownerId])
  @@index([isPublic, status])
  @@map("garment_models")
}

model Look {
  id           String       @id @default(uuid())
  name         String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String       @map("owner_id")
  // Catalog models must not disappear from under saved looks.
  garmentModel GarmentModel @relation(fields: [garmentModelId], references: [id], onDelete: Restrict)
  garmentModelId String     @map("garment_model_id")
  // Reference + snapshot: colorHex keeps rendering if the color is deleted.
  color        Color?       @relation(fields: [colorId], references: [id], onDelete: SetNull)
  colorId      String?      @map("color_id")
  colorHex     String       @map("color_hex")
  pattern      Pattern?     @relation(fields: [patternId], references: [id], onDelete: SetNull)
  patternId    String?      @map("pattern_id")
  patternScale Float        @default(1) @map("pattern_scale")
  thumbnailKey String?      @map("thumbnail_key")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("looks")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
