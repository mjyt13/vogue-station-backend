# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://vogue:vogue@localhost:5432/vogue_station?schema=public"

# First admin account, created/promoted by `npm run db:seed` (optional)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

PORT=3000
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# Storage: "local" (dev, filesystem) or "s3" (R2/MinIO/AWS)
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="storage"
# Generate with: openssl rand -base64 48
STORAGE_SIGNING_SECRET="change-me"

# Only needed when STORAGE_DRIVER=s3.
# R2:    endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, path style false
# MinIO: endpoint http://localhost:9000, region us-east-1, path style true
S3_ENDPOINT=""
# Origin used only to SIGN URLs handed to the browser (GET/PUT). Must be
# reachable from outside the docker network — e.g. a Caddy route that
# proxies to MinIO. Falls back to S3_ENDPOINT if unset, which is wrong for
# any deployment where S3_ENDPOINT is an internal docker hostname.
S3_PUBLIC_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="vogue-station"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
